# LLM 配置 (支持 OpenAI 或任何 OpenAI 兼容协议接口，如 DashScope/Qwen、DeepSeek、OpenAI 等)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4

# 服务配置
HOST=0.0.0.0
PORT=9933

# 知识库元数据存储 (PostgreSQL + pgvector)
# 如果使用本项目的 Docker Compose 或本地 PostgreSQL：
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_agent_tutorial

